{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/news.db"
  },
  "Auth": {
    "Username": "admin",
    "PasswordHash": ""
  },
  "Ai": {
    "Providers": [ "cloudflare", "gemini" ],
    "MaxClustersPerRun": 100
  },
  "Cloudflare": {
    "AccountId": "",
    "ApiToken": "",
    "EmbeddingModel": "@cf/baai/bge-m3",
    "ChatModel": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "ChatBatchSize": 20,
    "ChatMaxTokens": 2048
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-flash-latest",
    "BatchSize": 25
  },
  "Refresh": {
    "WindowHours": 48,
    "SimilarityThreshold": 0.72,
    "RetentionDays": 30
  },
  "Trends": {
    "Enabled": true,
    "FeedUrl": "https://trends.google.com/trending/rss?geo=VN"
  },
  "Vite": {
    "DevServerUrl": ""
  },
